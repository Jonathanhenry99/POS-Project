# Salin menjadi .env lalu isi. Di hosting (Railway/Render), isi lewat menu Environment Variables.
NODE_ENV=production
PORT=8787
# Koneksi PostgreSQL. Development lokal (npm run db:dev): postgres://postgres:postgres@localhost:54329/mourden
DATABASE_URL=postgres://user:password@host:5432/mourden
# Rahasia untuk sesi login. Isi dengan teks acak panjang, misalnya hasil: openssl rand -hex 32
JWT_SECRET=ganti-dengan-teks-acak-panjang
# Opsional: origin lain yang boleh mengakses API (dipisah koma). Kosongkan bila web & API satu alamat.
CORS_ORIGINS=
