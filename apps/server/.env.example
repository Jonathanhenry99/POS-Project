# Salin menjadi .env lalu isi. Di hosting (Railway/Render), isi lewat menu Environment Variables.
NODE_ENV=production
PORT=8787
# Koneksi PostgreSQL. Development lokal tidak perlu diisi (npm run dev memakai database lokal).
DATABASE_URL=postgres://user:password@host:5432/mourden
# Rahasia untuk sesi login: minimal 32 karakter acak. Contoh membuatnya: openssl rand -hex 32
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
# Akun owner pertama (hanya dipakai sekali saat database masih kosong).
# PIN wajib 6 angka dan tidak mudah ditebak (bukan 123456/111111). Simpan baik-baik; bisa diganti nanti di aplikasi.
INITIAL_OWNER_PIN=
INITIAL_OWNER_NAME=Owner
INITIAL_OWNER_USERNAME=owner
# Opsional: origin lain yang boleh mengakses API (dipisah koma). Kosongkan bila web & API satu alamat.
CORS_ORIGINS=
